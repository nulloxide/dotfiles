# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Using Starship for prompt instead of OMZ theme
ZSH_THEME=""

# Disable oh-my-zsh auto-update (chezmoi manages it via .chezmoiexternal)
DISABLE_AUTO_UPDATE="true"

plugins=(zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# PATH is configured in .zprofile (login shell)
# Do not set PATH here to avoid duplication

# Initialize fnm (Fast Node Manager - replaces NVM)
eval "$(fnm env --use-on-cd)"

# Source local environment if available
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Initialize zoxide (smart cd replacement)
eval "$(zoxide init zsh)"

# Initialize direnv (environment management)
eval "$(direnv hook zsh)"

# Initialize fzf (fuzzy finder) - enhanced configuration
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='
  --height 40% --layout=reverse --border
  --color=fg:#f8f8f2,bg:#282a36,hl:#bd93f9
  --color=fg+:#f8f8f2,bg+:#44475a,hl+:#bd93f9
  --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6
  --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4
  --preview "bat --color=always --style=numbers --line-range=:500 {}"
  --bind "ctrl-/:toggle-preview"
'

# Modern CLI tool aliases
alias ls='eza --icons'
alias ll='eza -lah --icons'
alias la='eza -a --icons'
alias lt='eza --tree --icons'
alias cat='bat'
alias find='fd'

# Git aliases (complement gitconfig)
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gco='git checkout'
alias gb='git branch'
alias glg='git lg'

eval "$(starship init zsh)"

# Initialize Atuin (magical shell history)
eval "$(atuin init zsh)"

# Zellij aliases (terminal multiplexer)
alias zj='zellij'
alias zja='zellij attach'
alias zjl='zellij list-sessions'
